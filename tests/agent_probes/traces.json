            "parameters": {
              "type": "object",
              "properties": {
                "query": {
                  "type": "string",
                  "minLength": 3
                },
                "limit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                }
              },
              "required": [
                "query"
              ],
              "additionalProperties": false
            }
          }
        ],
        "policy": {
          "forbidden_tools": [],
          "max_tool_calls": null
        },
        "steps": [
          {
            "kind": "tool_call",
            "id": "t1",
            "name": "get_order",
            "arguments": {
              "order_id": "ORD-1"
            },
            "result": "Order ORD-1 shipped on 3 March 2026 and is in transit.",
            "error": null
          }
        ],
        "final_answer": "Order ORD-1 shipped on 3 March 2026."
      },
      "expected_failed_checks": [],
      "must_accept": true,
      "must_not_accept": false,
      "rationale": "Valid call, answer stated by the tool output."
    },
