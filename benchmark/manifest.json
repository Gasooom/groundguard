{
  "benchmark": {
    "name": "GroundGuard V1",
    "version": "1.0.0",
    "target_size": 250,
    "status": "CONSTRUCTION"
  },
  "label_dimensions": {
    "grounding": [
      "SUPPORTED",
      "PARTIALLY_SUPPORTED",
      "UNSUPPORTED"
    ],
    "relevance": [
      "RELEVANT",
      "IRRELEVANT"
    ],
    "contradiction": [
      "CONTRADICTORY",
      "NOT_CONTRADICTORY"
    ]
  },
  "construction_targets": {
    "grounding": {
      "SUPPORTED": 50,
      "PARTIALLY_SUPPORTED": 35,
      "UNSUPPORTED": 35
    },
    "coverage": {
      "RELEVANT_BUT_UNSUPPORTED": 25,
      "IRRELEVANT": 25,
      "MULTI_CLAIM_OR_EDGE_CASE": 25,
      "NUMERICAL_TEMPORAL_OR_PARAPHRASE": 20
    }
  },
  "data_sources": {
    "synthetic": {
      "target": 125,
      "purpose": "Controlled coverage of specific failure modes."
    },
    "public_text": {
      "target": 125,
      "purpose": "Realistic evaluation examples derived from public factual text."
    }
  },
  "construction_rules": {
    "targets_are_overlapping": true,
    "grounding_and_relevance_are_independent": true,
    "grounding_and_contradiction_are_independent": true,
    "unsupported_does_not_imply_contradictory": true,
    "partial_support_requires_multiple_substantive_claims": true,
    "evidence_must_be_traceable_to_context": true,
    "external_knowledge_must_not_be_used_for_labeling": true
  },
  "id_ranges": {
